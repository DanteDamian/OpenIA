# Copiar a .env.local. No incluir credenciales privadas aquí.
# Para staging: URL HTTPS y clave publishable del MISMO proyecto independiente.
# NEXT_PUBLIC_* se captura al compilar; limitar Vercel a Preview, no Production.
# Procedimiento y controles: docs/STAGING_RUNBOOK.md.
# Preview/Auth: docs/VERCEL_PREVIEW_AUTH.md. La URL es variable normal, no secreto proxy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen HTTPS exacto del frontend. Preview puede usar VERCEL_URL automáticamente.
AUTH_SITE_URL=
# Secreto exclusivo del servidor: 32 bytes aleatorios en hexadecimal (64 caracteres).
# No usar prefijo NEXT_PUBLIC ni claves Supabase. Ver docs/PASSWORD_RECOVERY.md.
AUTH_RECOVERY_SECRET=
# No se requieren claves de OpenAI ni Alegra en esta etapa.
